# Identifiants de l'application Netatmo (https://dev.netatmo.com/apps)
# Scope requis : read_station
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=

# Renseigné automatiquement par `npm run netatmo:auth` (server/.netatmo-token.json).
# Vous pouvez aussi le coller ici en secours, mais il est remplacé (rotation) à
# chaque rafraîchissement, donc le fichier .netatmo-token.json reste la source de vérité.
NETATMO_REFRESH_TOKEN=

# Port du petit serveur proxy (server/index.js) — Netatmo + Hue + Tuya + Kasa + Yeelight + Alexa
NETATMO_PROXY_PORT=4000

# ── Philips Hue (bridge local) ───────────────────────────────────────────────
# HUE_BRIDGE_IP=192.168.x.x
# HUE_API_KEY=   # obtenu via POST /api/hue/pair après appui sur le bouton du bridge

# ── Tuya Cloud — Clim mobile DrPrepare ───────────────────────────────────────
# Projet Cloud : https://iot.tuya.com/ → Cloud → Development → Authorization Key
# Région Europe (France) : https://openapi.tuyaeu.com
# Autres : tuyaus.com (US) / tuyacn.com (CN) / tuyain.com (IN)
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
TUYA_BASE_URL=https://openapi.tuyaeu.com

# Codes DP optionnels si votre firmware DrPrepare n'utilise pas le mapping standard.
# Vérifiez-les via GET /api/tuya/device (champ specification).
# TUYA_DP_SWITCH=switch
# TUYA_DP_TEMP_SET=temp_set
# TUYA_DP_TEMP_CURRENT=temp_current
# TUYA_DP_MODE=mode
# TUYA_DP_FAN=fan_speed_enum
# Valeurs enum ventilation si différentes de low/mid/high :
# TUYA_FAN_1=low
# TUYA_FAN_2=mid
# TUYA_FAN_3=high

# ── TP-Link Kasa (prises locales LAN) ────────────────────────────────────────
# Mapping deviceId Orion → IP, séparés par des virgules.
# Pour trouver les IPs : GET http://localhost:4000/api/kasa/discover
# KASA_DEVICES=tplink-verres:192.168.1.50,tplink-clim:192.168.1.51
KASA_DEVICES=

# ── Yeelight (rubans LED locaux LAN) ─────────────────────────────────────────
# Activer « Contrôle LAN » dans l'app Yeelight pour chaque ruban, puis mapper :
# YEELIGHT_DEVICES=yeelight-tv:192.168.1.60,yeelight-sejour:192.168.1.61,yeelight-sdb:192.168.1.62
# Pour trouver les IPs : GET http://localhost:4000/api/yeelight/discover
YEELIGHT_DEVICES=

# ── Amazon Alexa (API non officielle — alexa-remote2) ────────────────────────
# 1. npm run alexa:auth  → ouvre http://127.0.0.1:3001/ et connecte-toi Amazon
# 2. Cookie sauvé dans server/.alexa-cookie.json (ne pas committer)
# 3. Liste les Echo : GET http://localhost:4000/api/alexa/echoes
# 4. Mappe id Orion → serialNumber :
# ALEXA_DEVICES=alexa-salon:G090XXXX,alexa-cuisine:G090YYYY,alexa-bureau:…,alexa-chambre:…,alexa-sdb:…
ALEXA_DEVICES=
# ALEXA_AMAZON_PAGE=amazon.fr
# ALEXA_SERVICE_HOST=alexa.amazon.fr
# ALEXA_PROXY_OWN_IP=127.0.0.1
# ALEXA_PROXY_PORT=3001
